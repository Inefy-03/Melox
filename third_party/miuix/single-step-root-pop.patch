 import kotlin.test.assertTrue
 
 class NavPresentationMathTest {
+    @Test
+    fun rootPop_compressesTheWholeStackIntoOneTransition() {
+        val state = NavPresentation(3f)
+        state.rootPopOrigin = 3
+        for (top in listOf(3f, 2.25f, 1.5f, 0.75f, 0f)) {
+            assertEquals(top / 3f, state.depthAt(top, 0))
+            assertEquals((top - 3f) / 3f, state.depthAt(top, 3))
+            assertEquals(-2f, state.depthAt(top, 1))
+            assertEquals(-2f, state.depthAt(top, 2))
+        }
+        assertTrue(state.depthAt(0.75f, 3) > -1f)
+        assertEquals(-1f, state.depthAt(0f, 3))
+        state.rootPopOrigin = null
+        assertEquals(2f, state.depthAt(3f, 1))
+    }
