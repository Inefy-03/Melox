+    scrollState: ScrollState = rememberScrollState(),
+    content: @Composable ColumnScope.() -> Unit,
+) {
+    NavigationRailImpl(
+        modifier = modifier,
+        state = state,
+        statusBarInsets = statusBarInsets,
+        expanded = false,
+        header = header,
