<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">





  <modelVersion>4.0.0</modelVersion>
  <groupId>top.yukonga.miuix.kmp</groupId>
  <artifactId>miuix-ui-android</artifactId>
  <version>0.9.4.3-melox</version>
  <packaging>aar</packaging>
  <name>Miuix UI - Melox local patch</name>
  <description>A UI library for Compose Multiplatform</description>
  <url>https://github.com/compose-miuix-ui/miuix</url>
  <licenses>
    <license>
      <name>The Apache Software License, Version 2.0</name>
      <url>https://github.com/compose-miuix-ui/miuix/blob/main/LICENSE</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>compose-miuix-ui</id>
      <name>compose-miuix-ui</name>
      <url>https://github.com/compose-miuix-ui</url>
    </developer>
  </developers>
  <scm>
    <connection>https://github.com/compose-miuix-ui/miuix.git</connection>
    <url>https://github.com/compose-miuix-ui/miuix</url>
  </scm>
  <issueManagement>
    <system>Github</system>
    <url>https://github.com/compose-miuix-ui/miuix/issues</url>
  </issueManagement>
  <dependencies>
    <dependency>
      <groupId>top.yukonga.miuix.kmp</groupId>
      <artifactId>miuix-core-android</artifactId>
      <version>0.9.4</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>top.yukonga.miuix.kmp</groupId>
      <artifactId>miuix-squircle-android</artifactId>
      <version>0.9.4</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.compose.foundation</groupId>
      <artifactId>foundation-android</artifactId>
      <version>1.12.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>2.4.20</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>androidx.navigationevent</groupId>
      <artifactId>navigationevent-compose-android</artifactId>
      <version>1.1.2</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.compose.material3</groupId>
      <artifactId>material3-window-size-class-android</artifactId>
      <version>1.12.0-alpha03</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.materialkolor</groupId>
      <artifactId>material-color-utilities-android</artifactId>
      <version>5.0.1</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
